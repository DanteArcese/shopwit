# Copy to .env and fill in values. Never commit .env.
# Load with: uv run --env-file .env <command>

# --- Sovrn Commerce (https://knowledge.sovrn.com) ---
# Dev/testing may use an existing campaign's keys; production needs a site
# approved for unitpricer's own domain.
SOVRN_API_KEY=
SOVRN_SECRET_KEY=
# The *site* key from the Sovrn dashboard (used in outbound links), not the API key.
SOVRN_SITE_KEY=

# --- Amazon Associates + Creators API (successor to PA-API 5) ---
# Creators API access requires an approved Associates account with recent
# qualifying sales; credentials are created under Tools > Creators API.
AMAZON_ASSOCIATES_TAG=
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=

# --- Walmart affiliate (Impact) + walmart.io Affiliate API ---
# Consumer ID is issued after uploading a public key on walmart.io.
# Private key: single-line Base64 or full PEM.
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY=
WALMART_IMPACT_PUBLISHER_ID=

# --- Impact (Target Partners, Instacart, others): reporting API, later ---
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# --- CJ Affiliate (Costco, Shaw's, others): later ---
CJ_PERSONAL_ACCESS_TOKEN=
CJ_PUBLISHER_ID=

# --- Django / unitpricer ---
DATABASE_URL=
DJANGO_SECRET_KEY=
# Comma-separated old keys, only during a rotation.
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_STATIC_ROOT=
WEB_CONCURRENCY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
UNITPRICER_REFRESH_HOURS=
UNITPRICER_FRESHNESS_HOURS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HSTS_SECONDS=
DJANGO_LOG_LEVEL=
UNITPRICER_PUBLIC_HOST=
UNITPRICER_APP_HOST=
UNITPRICER_PUBLIC_URL=
UNITPRICER_SITE_URL=
UNITPRICER_POSTAL_ADDRESS=
UNITPRICER_TRUST_CF_IP=
UNITPRICER_DAILY_EMAIL_CAP=
# --- Open Prices (in-store shelf prices, "Seen in stores") ---
# Currency the site shows; offers in other currencies are hidden (default USD).
UNITPRICER_CURRENCY=
# Days an observed price stays visible, by observation date (default 90).
UNITPRICER_OBSERVED_MAX_AGE_DAYS=
# Set to 1 to run the Open Prices sync (default off).
UNITPRICER_OPEN_PRICES=
# Country of the stores to ingest (default US).
UNITPRICER_OPEN_PRICES_COUNTRY=
# Hours between syncs (default 24).
UNITPRICER_OPEN_PRICES_HOURS=
# Set to 0 to skip price-tag/receipt assistant entries (default 1, included).
UNITPRICER_OPEN_PRICES_ASSISTED=
# --- Open-ended search ---
# Set to 1 to let live searches query Open Food Facts (default off).
UNITPRICER_LIVE_OFF=
# Fetch worker threads, 1 or 2 (default 1).
UNITPRICER_FETCH_THREADS=
# Hours between warm-up fetches of popular phrases (default 12).
UNITPRICER_WARM_HOURS=
# Token buckets per source: off-search (10, 1/6 per s), openprices (5, 1.0), walmart (5, 1.0, 5000/day).
# Applied only when a SourceBudget row is first created; later edits go in the admin.
# A _DAILY_LIMIT that is unset or blank uses the default (walmart 5000/day, the others no cap).
# Set it to a number to change the cap, or to `unlimited` to remove it.
UNITPRICER_BUDGET_OFF_SEARCH_CAPACITY=
UNITPRICER_BUDGET_OFF_SEARCH_REFILL_PER_SECOND=
UNITPRICER_BUDGET_OFF_SEARCH_DAILY_LIMIT=
UNITPRICER_BUDGET_OPENPRICES_CAPACITY=
UNITPRICER_BUDGET_OPENPRICES_REFILL_PER_SECOND=
UNITPRICER_BUDGET_OPENPRICES_DAILY_LIMIT=
UNITPRICER_BUDGET_WALMART_CAPACITY=
UNITPRICER_BUDGET_WALMART_REFILL_PER_SECOND=
UNITPRICER_BUDGET_WALMART_DAILY_LIMIT=
# Cloudflare Access on the app host: team domain (e.g. unitpricer.cloudflareaccess.com) and application AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Production email goes through Resend SMTP on port 2587 (DigitalOcean blocks 25/465/587):
# host smtp.resend.com, user resend, password = RESEND_API_KEY.
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=
DJANGO_DEFAULT_FROM_EMAIL=
# --- Feedback: moderated GitHub sync ---
# Fine-grained token limited to Issues (read/write) on this repo. Blank = sync off
# (approving in the admin only marks items approved).
UNITPRICER_GITHUB_TOKEN=
# owner/name of the repo issues are filed in (default DanteArcese/unitpricer).
UNITPRICER_GITHUB_REPO=

# --- Deploy tooling (not read by the app) ---
# DigitalOcean API token with write scope (API > Generate New Token).
DIGITALOCEAN_ACCESS_TOKEN=
# Nightly backups (server /srv/unitpricer/.env). R2 is optional until enabled;
# without it dumps stay in the backups volume.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_HEARTBEAT_URL=

# --- Resend (transactional email: waitlist confirmations, sign-in links) ---
RESEND_API_KEY=
