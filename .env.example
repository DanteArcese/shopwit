# Copy to .env and fill in values. Never commit .env.
# Load with: uv run --env-file .env <command>

# --- Sovrn Commerce (https://knowledge.sovrn.com) ---
# Dev/testing may use an existing campaign's keys; production needs a site
# approved for unitpricer's own domain.
SOVRN_API_KEY=
SOVRN_SECRET_KEY=
# The *site* key from the Sovrn dashboard (used in outbound links), not the API key.
SOVRN_SITE_KEY=

# --- Amazon Associates + Creators API (successor to PA-API 5) ---
# Creators API access requires an approved Associates account with recent
# qualifying sales; credentials are created under Tools > Creators API.
AMAZON_ASSOCIATES_TAG=
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=

# --- Walmart affiliate (Impact) + walmart.io Affiliate API ---
# Consumer ID is issued after uploading a public key on walmart.io.
# Private key: single-line Base64 or full PEM.
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY=
WALMART_IMPACT_PUBLISHER_ID=

# --- Impact (Target Partners, Instacart, others): reporting API, later ---
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# --- CJ Affiliate (Costco, Shaw's, others): later ---
CJ_PERSONAL_ACCESS_TOKEN=
CJ_PUBLISHER_ID=

# --- Django / unitpricer ---
DATABASE_URL=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
UNITPRICER_REFRESH_HOURS=
UNITPRICER_FRESHNESS_HOURS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HSTS_SECONDS=
DJANGO_LOG_LEVEL=
UNITPRICER_PUBLIC_HOST=
UNITPRICER_APP_HOST=
UNITPRICER_PUBLIC_URL=
UNITPRICER_SITE_URL=
UNITPRICER_POSTAL_ADDRESS=
UNITPRICER_TRUST_CF_IP=
UNITPRICER_DAILY_EMAIL_CAP=
# Cloudflare Access on the app host: team domain (e.g. unitpricer.cloudflareaccess.com) and application AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Production email goes through Resend SMTP on port 2587 (DigitalOcean blocks 25/465/587):
# host smtp.resend.com, user resend, password = RESEND_API_KEY.
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=
DJANGO_DEFAULT_FROM_EMAIL=

# --- Deploy tooling (not read by the app) ---
# DigitalOcean API token with write scope (API > Generate New Token).
DIGITALOCEAN_ACCESS_TOKEN=

# --- Resend (transactional email: waitlist confirmations, sign-in links) ---
RESEND_API_KEY=
